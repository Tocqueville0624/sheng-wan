---
import { site } from "@/config/site";
---

<nav class="social-links" aria-label="Contact links">
  <a href={`mailto:${site.email}`} aria-label="Email" title={`Email ${site.email}`}>
    <svg
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
      class="contact-icon contact-icon--mail"
    >
      <rect x="3" y="5" width="18" height="14" rx="1.5"></rect>
      <path d="m3.5 6 8.5 7 8.5-7"></path>
    </svg>
  </a>
  <a
    href={site.links.linkedin}
    aria-label="LinkedIn"
    title="LinkedIn"
    rel="me noopener"
    target="_blank"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="contact-icon">
      <path
        d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96C2 21.32 2.69 22 3.55 22h16.9c.86 0 1.55-.68 1.55-1.52V3.52C22 2.68 21.31 2 20.45 2ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.3h.04c.39-.74 1.36-1.52 2.79-1.52 2.98 0 3.58 1.96 3.58 4.51v5.26Z"
      ></path>
    </svg>
  </a>
  <a href={site.links.github} aria-label="GitHub" title="GitHub" rel="me noopener" target="_blank">
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="contact-icon">
      <path
        d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.28.1-2.66 0 0 .84-.27 2.75 1.03A9.58 9.58 0 0 1 12 6.81c.85 0 1.71.12 2.51.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.41.1 2.66.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
      ></path>
    </svg>
  </a>
</nav>
