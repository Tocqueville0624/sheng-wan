---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GalleryExperience from "@features/gallery/GalleryExperience";
import manifestData from "@/data/generated/media.json";
import type { MediaManifest } from "@/types/media";

const manifest = manifestData as MediaManifest;
---

<BaseLayout
  title="Photo Gallery"
  description="Photography by Sheng Wan, presented as an editorial gallery and contact sheet."
>
  <header class="page-intro shell gallery-intro">
    <h1 class="eyebrow">Photography</h1>
  </header>
  <GalleryExperience images={manifest.gallery} client:load />
</BaseLayout>

<style>
  .gallery-intro {
    padding-bottom: 1.5rem;
  }
</style>
