---
import { getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { site } from "@/config/site";

const resume = await getEntry("cv", "resume");
if (!resume) throw new Error("CV content is missing");
const cv = resume.data;
const sections = [
  { id: "education", title: "Education", entries: cv.education },
  { id: "experience", title: "Professional Experience", entries: cv.experience },
  { id: "projects", title: "Personal Projects", entries: cv.projects }
];
---

<BaseLayout
  title="Résumé"
  description={`Professional experience, projects, education, and skills of ${site.name}.`}
>
  <header class="page-intro shell cv-header">
    <div>
      <p class="eyebrow">Résumé</p>
      <h1 class="page-title">{site.name}</h1>
      <ul class="cv-contact">
        <li>Seattle, WA</li>
        <li><a href={site.links.github}>GitHub</a></li>
        <li><a href="/">shengwan.org</a></li>
      </ul>
    </div>
    <div class="cv-downloads">
      <a class="button button--primary" href="/downloads/sheng-wan-resume-summer-2027.pdf" download
        >Download résumé (PDF)</a
      >
      <a href="/downloads/sheng-wan-cv.pdf" download>Download academic CV (PDF)</a>
    </div>
  </header>

  <div class="shell">
    {
      sections.map(({ id, title, entries }) => (
        <section class="cv-section" aria-labelledby={id}>
          <h2 id={id}>{title}</h2>
          <ul class="cv-list">
            {entries.map((entry) => (
              <li class="cv-entry">
                <div>
                  <h3>{entry.url ? <a href={entry.url}>{entry.title}</a> : entry.title}</h3>
                  {entry.subtitle && <p class="entry-subtitle">{entry.subtitle}</p>}
                </div>
                {entry.date && <span class="entry-date">{entry.date}</span>}
                {entry.details.length > 0 && (
                  <ul class="entry-details">
                    {entry.details.map((detail) => (
                      <li>{detail}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    <section class="cv-section" aria-labelledby="skills">
      <h2 id="skills">Skills</h2>
      <ul class="cv-list cv-list--compact">
        {
          cv.skills.map(({ label, value }) => (
            <li>
              <strong>{label}:</strong> {value}
            </li>
          ))
        }
      </ul>
    </section>
    <section class="cv-section" aria-labelledby="languages">
      <h2 id="languages">Languages</h2>
      <ul class="cv-list cv-list--compact">
        {cv.languages.map((language) => <li>{language}</li>)}
      </ul>
    </section>
    <section class="cv-section" aria-labelledby="awards">
      <h2 id="awards">Awards &amp; Fellowships</h2>
      <ul class="cv-list">
        {
          cv.awards.map((award) => (
            <li class="cv-entry">
              <div>
                <>
                  <h3>{award.title}</h3>
                  <p class="entry-subtitle">{award.subtitle}</p>
                </>
              </div>
              <span class="entry-date">{award.date}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
