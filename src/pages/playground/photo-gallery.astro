---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GalleryExperience from "@features/gallery/GalleryExperience";
import manifestData from "@/data/generated/media.json";
import type { MediaManifest } from "@/types/media";

const manifest = manifestData as MediaManifest;
---

<BaseLayout
  title="Photo Gallery"
  description="Photography by Sheng Wan, presented as an editorial gallery and contact sheet."
>
  <header class="page-intro shell gallery-intro">
    <p class="eyebrow">Photography</p>
    <h1 class="page-title">Light, distance, and a sense of place.</h1>
    <p class="lede">
      A selection of sixteen photographs. Choose an editorial sequence or scan the complete contact
      sheet.
    </p>
  </header>
  <GalleryExperience images={manifest.gallery} client:load />
</BaseLayout>

<style>
  .gallery-intro {
    padding-bottom: 1.5rem;
  }
  .gallery-intro .page-title {
    max-width: 24ch;
    font-size: clamp(2.6rem, 5.2vw, 4rem);
  }
</style>
